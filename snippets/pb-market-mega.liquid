<div class="pm-mega-grid">
{% case menu_kind %}
{% when 'gifts' %}
 <div><h3>By occasion</h3><a href="{{ routes.root_url }}#pb-halloween">Halloween</a><a href="{{ routes.root_url }}#pb-christmas">Christmas</a><a href="{{ routes.root_url }}#pb-wedding">Wedding</a><a href="{{ routes.search_url }}?type=product&amp;q=anniversary">Anniversary</a><a href="{{ routes.search_url }}?type=product&amp;q=birthday">Birthday</a><a href="{{ routes.search_url }}?type=product&amp;q=memorial">Memorial</a><a href="{{ routes.all_products_collection_url }}">Just because</a></div>
 <div><h3>By recipient</h3><a href="{{ routes.search_url }}?type=product&amp;q=dad">For Dad</a><a href="{{ routes.search_url }}?type=product&amp;q=mom">For Mom</a><a href="{{ routes.search_url }}?type=product&amp;q=friend">For Friends</a><a href="{{ routes.search_url }}?type=product&amp;q=couple">For Couples</a><a href="{{ routes.search_url }}?type=product&amp;q=teacher">For Teachers</a></div>
 <div><h3>By interest</h3><a href="{% render 'pb-market-link', handle: 'car-key-holders', query: 'car key holder' %}">Car lovers</a><a href="{% render 'pb-market-link', handle: 'book-counter', query: 'book counter' %}">Book lovers</a><a href="{% render 'pb-market-link', handle: 'zen-garden', query: 'zen garden' %}">Desk &amp; relaxation</a><a href="{{ routes.search_url }}?type=product&amp;q=pet">Pet lovers</a><a href="{{ routes.search_url }}?type=product&amp;q=sports">Sports fans</a></div>
 <div><h3>By budget</h3><a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=20">Under 20 {{ localization.country.currency.iso_code }}</a><a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=30">Under 30 {{ localization.country.currency.iso_code }}</a><a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=50">Under 50 {{ localization.country.currency.iso_code }}</a><a href="{{ routes.all_products_collection_url }}?filter.v.price.gte=50">50 {{ localization.country.currency.iso_code }} &amp; up</a><button class="pm-text-button" type="button" data-pm-open="PMGiftFinder">Find a gift →</button></div>
{% when 'home' %}
 <div><h3>Wall &amp; entryway</h3><a href="{% render 'pb-market-link', handle: 'key-holders', query: 'key holder' %}">Personalized key holders</a><a href="{% render 'pb-market-link', handle: 'car-key-holders', query: 'car key holder' %}">Car key holders</a><a href="{{ routes.search_url }}?type=product&amp;q=sign">Signs &amp; name decor</a></div>
 <div><h3>Bookshelf &amp; lighting</h3><a href="{% render 'pb-market-link', handle: 'book-counter', query: 'book counter' %}">Book counters</a><a href="{{ routes.search_url }}?type=product&amp;q=lamp">Lamps &amp; light boxes</a><a href="{% render 'pb-market-link', handle: 'decor', query: 'decor' %}">Decorative objects</a></div>
 <div><h3>Desk &amp; seasonal</h3><a href="{% render 'pb-market-link', handle: 'zen-garden', query: 'zen garden' %}">Zen gardens</a><a href="{{ routes.root_url }}#pb-halloween">Halloween decor</a><a href="{{ routes.root_url }}#pb-christmas">Christmas gifts</a><a href="{{ routes.root_url }}#pb-wedding">Wedding keepsakes</a></div>
{% else %}
 <div><h3>Shop collections</h3>{% for item_collection in collections %}{% if item_collection.all_products_count > 0 and item_collection.handle != 'all' %}<a href="{{ item_collection.url }}">{{ item_collection.title | escape }}</a>{% endif %}{% endfor %}</div>
 <div><h3>Discover Crestoria</h3><a href="{{ routes.all_products_collection_url }}">All products</a><a href="{% render 'pb-market-link', handle: 'best-sellers', query: 'gift' %}">Best sellers</a><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a><button type="button" class="pm-text-button" data-pm-open="PMGiftFinder">Gift finder</button><a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact</a></div>
{% endcase %}
</div>
