{% liquid
  assign use_marquee = false
  if section.settings.enable_marquee and section.settings.presentation != 'chips' and section.blocks.size > 1
    assign use_marquee = true
  endif
%}
{% if use_marquee %}
  {{ 'crestoria-occasions.css' | asset_url | stylesheet_tag }}
{% endif %}
<section class="pm-section pm-discovery pm-discovery--{{ section.settings.shape }}{% if section.settings.presentation == 'chips' %} pm-discovery--chips{% endif %}{% if use_marquee %} pm-discovery--marquee{% endif %}" aria-labelledby="PMTitle-{{ section.id }}"{% if use_marquee %} data-cr-occasions data-speed="{{ section.settings.marquee_speed | default: 28 }}"{% endif %}>
  <div class="pm-shell">
    <div class="pm-section-intro"><h{% if section.settings.is_main_heading %}1{% else %}2{% endif %} id="PMTitle-{{ section.id }}">{{ section.settings.title | escape }}</h{% if section.settings.is_main_heading %}1{% else %}2{% endif %}>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}</div>
    {% if use_marquee %}<div class="pm-occasion-window">{% endif %}
    <div class="pm-discovery-grid" style="--pm-tile-columns:{{ section.settings.columns }};"{% if use_marquee %} id="PMOccasionRail-{{ section.id }}" data-cr-occasion-rail tabindex="0" role="group" aria-label="{{ section.settings.title | escape }} — scroll horizontally" aria-live="off"{% endif %}>
      {% for block in section.blocks %}
        {% liquid
          assign tile_collection = block.settings.collection
          if tile_collection == blank
            capture tile_handle
              render 'pb-season-handle', handles: block.settings.collection_handles
            endcapture
            assign tile_handle = tile_handle | strip
            assign tile_collection = collections[tile_handle]
          endif
          assign tile_image = block.settings.image | default: tile_collection.featured_image
          assign tile_link = block.settings.link | default: tile_collection.url
          if tile_link == blank
            assign tile_query = block.settings.search_query | default: block.settings.title | url_encode
            assign tile_link = routes.search_url | append: '?type=product&q=' | append: tile_query
          endif
        %}
        <a class="pm-tile" href="{{ tile_link }}"{% if use_marquee %} data-cr-occasion-item="{{ block.id }}"{% endif %} {{ block.shopify_attributes }}>
          {% unless section.settings.presentation == 'chips' %}
            <span class="pm-tile-media">{% if tile_image != blank %}{{ tile_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '160, 240, 360, 500', sizes: '(min-width: 990px) 170px, 33vw', alt: block.settings.title }}{% else %}{% render 'pb-market-icon', icon: block.settings.icon %}{% endif %}</span>
          {% endunless %}
          <span class="pm-tile-label">{{ block.settings.title | escape }}</span>
        </a>
      {% endfor %}
    </div>
    {% if use_marquee %}
      </div>
      <div class="pm-occasion-controls" data-cr-occasion-controls hidden>
        <button type="button" data-cr-occasion-prev aria-label="Previous occasions" aria-controls="PMOccasionRail-{{ section.id }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m14 6-6 6 6 6"/></svg>
        </button>
        <button type="button" data-cr-occasion-toggle aria-label="Pause automatic scrolling" aria-pressed="false" aria-controls="PMOccasionRail-{{ section.id }}">
          <svg data-cr-pause-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M9 6v12M15 6v12"/></svg>
          <svg data-cr-play-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false" hidden><path d="m9 5 10 7-10 7Z"/></svg>
        </button>
        <button type="button" data-cr-occasion-next aria-label="Next occasions" aria-controls="PMOccasionRail-{{ section.id }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m10 6 6 6-6 6"/></svg>
        </button>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Crestoria Discovery",
  "tag": "section",
  "class": "pm-section-host",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Crestoria's Trending Finds"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "Discover personal touches for the people and spaces you love."
    },
    {
      "type": "checkbox",
      "id": "is_main_heading",
      "label": "Use as page main heading",
      "default": false
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Tile shape",
      "options": [
        {
          "value": "round",
          "label": "Round"
        },
        {
          "value": "square",
          "label": "Rounded square"
        }
      ],
      "default": "round"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "presentation",
      "label": "Display",
      "default": "tiles",
      "options": [
        {
          "value": "tiles",
          "label": "Image / icon categories"
        },
        {
          "value": "chips",
          "label": "Recipient buttons"
        }
      ]
    },
    {
      "type": "header",
      "content": "Horizontal movement"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Auto-scroll categories horizontally",
      "default": false,
      "info": "Continuous looping row with mouse drag, touch swipe and pause controls. Image / icon categories only."
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Scroll speed (pixels/second)",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 28,
      "info": "Lower values move more slowly. Customers can pause the movement."
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Personalized gifts"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "options": [
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "user",
              "label": "Person"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "pumpkin",
              "label": "Halloween"
            },
            {
              "value": "tree",
              "label": "Christmas"
            },
            {
              "value": "rings",
              "label": "Wedding / anniversary"
            },
            {
              "value": "leaf",
              "label": "Fall"
            },
            {
              "value": "candle",
              "label": "Memorial"
            },
            {
              "value": "cake",
              "label": "Birthday"
            },
            {
              "value": "paw",
              "label": "Pet lovers"
            },
            {
              "value": "cup",
              "label": "Cups"
            }
          ],
          "default": "gift"
        },
        {
          "type": "text",
          "id": "collection_handles",
          "label": "Auto-detect collection handles"
        },
        {
          "type": "text",
          "id": "search_query",
          "label": "Search when collection is missing"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Crestoria Discovery"
    }
  ]
}
{% endschema %}
