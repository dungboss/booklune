{{ 'crestoria-product-page.css' | asset_url | stylesheet_tag }}
<section class="eko-how">
 <div class="page-width">
  <div class="eko-how__eyebrow">{{ section.settings.eyebrow }}</div>
  <h2>{{ section.settings.heading }}</h2>
  <div class="eko-how__intro rte">{{ section.settings.text }}</div>
  <div class="eko-how__grid">
   {% for block in section.blocks %}
    <div class="eko-step" {{ block.shopify_attributes }}>
      <div class="eko-step__number">{{ forloop.index }}</div>
      <h3>{{ block.settings.title }}</h3>
      <p>{{ block.settings.text }}</p>
    </div>
   {% endfor %}
  </div>
 </div>
</section>
{% schema %}
{"name":"How personalization works","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Simple personalization"},{"type":"text","id":"heading","label":"Heading","default":"Create your personalized piece in four steps"},{"type":"richtext","id":"text","label":"Intro","default":"<p>Choose your style, add your details and review everything carefully before checkout.</p>"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title","default":"Choose your design"},{"type":"text","id":"text","label":"Text","default":"Select the product style and options you like."}]}],"presets":[{"name":"How personalization works","blocks":[{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}]}]}
{% endschema %}
