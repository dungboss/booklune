{% comment %}
  PLASTBAT — Macorner-style Shirt Product Page
  File: sections/plastbat-pdp-v24.liquid
  Native Shopify options: Style / Color / Size.
  Includes size chart, personalization preview, shipping card, accordions,
  and manual product reviews with filters, 10-per-page pagination, and modal.
{% endcomment %}

{% liquid
  assign pb_personalization_limit = 10
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'pbmac-form-' | append: section.id
  assign rating_object = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value

  assign has_native_color_option = false
  assign has_native_size_option = false

  for pbmac_option in product.options_with_values
    assign pbmac_option_name = pbmac_option.name | downcase

    if pbmac_option_name contains 'color' or pbmac_option_name contains 'colour'
      assign has_native_color_option = true
    endif

    if pbmac_option_name contains 'size'
      assign has_native_size_option = true
    endif
  endfor

  assign pbmac_fallback_color_names = 'Red|Orange|Yellow|Beige|Gold|Brown|Green|Blue|Navy|Grey|Purple|Black|White|Turquoise|Olive|Light Pink|Cyan|Light Purple' | split: '|'
  assign pbmac_fallback_color_hexes = '#EF2B2D|#FF8500|#FFD400|#E9D8AF|#D79B00|#9D5E3B|#0AAE4F|#126BD1|#292C97|#909497|#A250D6|#050607|#FFFFFF|#42CDC8|#7A7F0B|#F7B7C3|#16D8DF|#A34FD3' | split: '|'
  assign pbmac_fallback_sizes = 'S|M|L|XL|2XL|3XL|4XL|5XL' | split: '|'

  assign pbmac_manual_review_count = 0
  assign pbmac_manual_rating_total = 0
  for pbmac_review_block in section.blocks
    if pbmac_review_block.type == 'manual_review'
      assign pbmac_manual_review_count = pbmac_manual_review_count | plus: 1
      assign pbmac_manual_rating_total = pbmac_manual_rating_total | plus: pbmac_review_block.settings.rating
    endif
  endfor

  if pbmac_manual_review_count > 0
    assign pbmac_manual_average = pbmac_manual_rating_total | times: 1.0 | divided_by: pbmac_manual_review_count
    assign pbmac_manual_average_rounded = pbmac_manual_average | round
  else
    assign pbmac_manual_average = 0
    assign pbmac_manual_average_rounded = 0
  endif

  if current_variant.compare_at_price > current_variant.price
    assign initial_save = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  else
    assign initial_save = 0
  endif
%}

<section id="PBMac-{{ section.id }}" class="pbmac color-{{ section.settings.color_scheme }}">
  <div class="page-width pbmac__wrap">
    <div class="pbmac__grid">
      <div class="pbmac-gallery{% if section.settings.sticky_gallery %} pbmac-gallery--sticky{% endif %}">
        <div class="pbmac-gallery__main">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div class="pbmac-gallery__slide{% if forloop.first %} is-active{% endif %}" data-pbmac-media="{{ forloop.index0 }}" data-pbmac-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>
                {% case media.media_type %}
                  {% when 'image' %}
                    {{ media.preview_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480,720,960,1200,1600', sizes: '(min-width: 990px) 52vw, 100vw', class: 'pbmac-gallery__image', alt: media.alt | default: product.title }}
                  {% when 'video' %}
                    {{ media | video_tag: controls: true, image_size: '1200x', class: 'pbmac-gallery__video' }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag: class: 'pbmac-gallery__video' }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'pbmac-gallery__video' }}
                  {% else %}
                    {{ media.preview_image | image_url: width: 1600 | image_tag: class: 'pbmac-gallery__image', alt: media.alt | default: product.title }}
                {% endcase %}
              </div>
            {% endfor %}
            {% if product.media.size > 1 %}
              <button type="button" class="pbmac-gallery__arrow pbmac-gallery__arrow--prev" data-pbmac-prev>‹</button>
              <button type="button" class="pbmac-gallery__arrow pbmac-gallery__arrow--next" data-pbmac-next>›</button>
            {% endif %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'pbmac-gallery__placeholder' }}
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="pbmac-gallery__thumbs">
            {% for media in product.media %}
              <button type="button" class="pbmac-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-pbmac-thumb="{{ forloop.index0 }}">
                {{ media.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', class: 'pbmac-gallery__thumb-image', alt: media.alt | default: product.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="pbmac-info">
        <h1 class="pbmac-title">{{ product.title }}</h1>

        {% if pbmac_manual_review_count > 0 %}
          <div class="pbmac-meta">
            <a href="#pbmac-reviews-{{ section.id }}" class="pbmac-rating pbmac-rating--manual" aria-label="Read product reviews">
              <span class="pbmac-rating__stars" aria-hidden="true">
                {% for i in (1..5) %}
                  <i class="{% if i <= pbmac_manual_average_rounded %}is-on{% endif %}">★</i>
                {% endfor %}
              </span>
              <em>({{ pbmac_manual_review_count }})</em>
            </a>
          </div>
        {% elsif rating_object != blank %}
          <div class="pbmac-meta">
            <a href="#pbmac-reviews-{{ section.id }}" class="pbmac-rating" aria-label="Read product reviews">
              <span>★★★★★</span>
              {% if rating_count != blank %}<em>({{ rating_count }})</em>{% endif %}
            </a>
          </div>
        {% endif %}

        <div class="pbmac-price-row" aria-live="polite">
          <span class="pbmac-compare{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}" data-pbmac-compare>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money_with_currency }}{% endif %}</span>
          <span class="pbmac-price" data-pbmac-price>{{ current_variant.price | money_with_currency }}</span>
          <span class="pbmac-save{% if initial_save == 0 %} is-hidden{% endif %}{% unless section.settings.show_save_badge %} pbmac-save--hidden{% endunless %}" data-pbmac-save>Save {{ initial_save }}%</span>
        </div>



        {% form 'product', product, id: product_form_id, class: 'pbmac-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pbmac-variant-id>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% assign option_name_down = option.name | downcase %}
              {% assign option_type = 'pill' %}
              {% assign option_visible = true %}

              {% if option_name_down contains 'color' or option_name_down contains 'colour' %}
                {% assign option_type = 'color' %}
                {% assign option_visible = false %}
              {% elsif option_name_down contains 'size' %}
                {% assign option_visible = section.settings.show_size_option %}
              {% elsif option_name_down contains 'style' %}
                {% assign option_visible = section.settings.show_style_option %}
              {% endif %}

              <fieldset
                class="pbmac-option"
                data-pbmac-option-index="{{ forloop.index0 }}"
                {% unless option_visible %}hidden{% endunless %}
              >
                <div class="pbmac-option__head">
                  <legend>
                    {{ option.name }}
                    {% if option_type == 'color' %}
                      <span class="pbmac-option__selected" data-pbmac-color-selected>{{ option.selected_value }}</span>
                    {% endif %}
                  </legend>
                  {% if option_name_down contains 'size' and section.settings.show_size_chart %}
                    <button type="button" class="pbmac-sizechart-link" data-pbmac-sizechart-open>Size Chart</button>
                  {% endif %}
                </div>

                {% if option_type == 'color' %}
                  <div class="pbmac-colors">
                    {% for option_value in option.values %}
                      {% assign value_name = option_value.name %}
                      <label
                        class="pbmac-color{% unless option_value.available %} is-unavailable{% endunless %}"
                        title="{{ value_name | escape }}"
                        aria-label="{{ value_name | escape }}"
                      >
                        <input
                          type="radio"
                          name="pbmac-opt-{{ section.id }}-{{ option.position }}"
                          value="{{ value_name | escape }}"
                          data-pbmac-option-value
                          data-pbmac-color-value
                          {% if option_value.selected %}checked{% endif %}
                        >
                        <span class="pbmac-color__outer">
                          <span
                            class="pbmac-color__swatch pbmac-color--{{ value_name | handleize }}"
                            {% if option_value.swatch.color != blank %}style="background:{{ option_value.swatch.color }}"{% endif %}
                          ></span>
                        </span>
                      </label>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="pbmac-pills">
                    {% for option_value in option.values %}
                      <label class="pbmac-pill{% unless option_value.available %} is-unavailable{% endunless %}"><input type="radio" name="pbmac-opt-{{ section.id }}-{{ option.position }}" value="{{ option_value.name | escape }}" data-pbmac-option-value {% if option_value.selected %}checked{% endif %}><span>{{ option_value.name }}</span></label>
                    {% endfor %}
                  </div>
                {% endif %}
              </fieldset>
            {% endfor %}
          {% endunless %}
{% if section.settings.show_size_option %}
            {% unless has_native_size_option %}
            <fieldset class="pbmac-fallback-option pbmac-fallback-size">
              <div class="pbmac-fallback-option__head">
                <legend>Size</legend>

                {% if section.settings.show_size_chart %}
                  <button type="button" class="pbmac-sizechart-link" data-pbmac-sizechart-open>
                    ⚖ Size Chart
                  </button>
                {% endif %}
              </div>

              <div class="pbmac-fallback-size-pills" role="radiogroup" aria-label="Size">
                {% for pbmac_size in pbmac_fallback_sizes %}
                  <label class="pbmac-fallback-size-pill">
                    <input
                      type="radio"
                      name="properties[Size]"
                      value="{{ pbmac_size | escape }}"
                      data-pbmac-custom-size
                      {% if forloop.first %}checked{% endif %}
                    >
                    <span>{{ pbmac_size }}</span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>
            {% endunless %}
          {% endif %}

          {% if section.settings.show_personalization %}
            <div class="pbmac-personalization-card">
              <div class="pbmac-personalization-card__banner">
                <span class="pbmac-personalization-card__sparkles" aria-hidden="true">
                  <i class="pbmac-sparkle pbmac-sparkle--1">✦</i>
                  <i class="pbmac-sparkle pbmac-sparkle--2">✦</i>
                  <i class="pbmac-sparkle pbmac-sparkle--3">✦</i>
                </span>
                <strong>{{ section.settings.personalization_heading | escape }}</strong>
              </div>

              <div class="pbmac-personalization-card__body">
                <label for="PBMacPersonalization-{{ section.id }}">
                  {{ section.settings.personalization_field_label | escape }}
                  {% if section.settings.personalization_required %}<sup>*</sup>{% endif %}
                </label>

                <div class="pbmac-personalization-card__input-wrap">
                  <input
                    id="PBMacPersonalization-{{ section.id }}"
                    type="text"
                    class="pbmac-input"
                    name="properties[Personalization]"
                    maxlength="{{ pb_personalization_limit }}"
                    placeholder="{{ section.settings.personalization_placeholder | escape }}"
                    data-pbmac-personalization
                    {% if section.settings.personalization_required %}required{% endif %}
                  >

                  <span class="pbmac-personalization-card__counter">
                    <b data-pbmac-personalization-count>0</b>/{{ pb_personalization_limit }}
                  </span>
                </div>

                {% if section.settings.personalization_helper != blank %}
                  <p>{{ section.settings.personalization_helper | escape }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if section.settings.show_personalization %}
            <div class="pbmac-customization-summary" data-pbmac-summary>
              <div class="pbmac-customization-summary__icon" aria-hidden="true">✓</div>
              <div class="pbmac-customization-summary__content">
                <strong>{{ section.settings.customization_summary_heading | escape }}</strong>
                <span><em data-pbmac-summary-text>{{ section.settings.customization_summary_empty | escape }}</em></span>
              </div>
            </div>
          {% endif %}

          <div class="pbmac-buy-row pbmac-buy-row--compact">
            <div class="pbmac-qty">
              <button type="button" data-pbmac-minus aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" max="99" data-pbmac-qty aria-label="Quantity">
              <button type="button" data-pbmac-plus aria-label="Increase quantity">+</button>
            </div>

            <button type="submit" name="add" class="pbmac-atc pbmac-atc--inline" data-pbmac-atc {% unless current_variant.available %}disabled{% endunless %}>
              <span data-pbmac-atc-text>{% if current_variant.available %}{% if section.settings.show_personalization %}{{ section.settings.personalized_add_to_cart_text | escape }}{% else %}{{ section.settings.add_to_cart_text | escape }}{% endif %}{% else %}{{ section.settings.sold_out_text | escape }}{% endif %}</span>
              <span class="pbmac-atc__arrow" aria-hidden="true">→</span>
            </button>
          </div>
        {% endform %}

        <div class="pbmac-trust">
          <p><span class="pbmac-trust__check" aria-hidden="true">✓</span><span>{{ section.settings.trust_1 | escape }}</span></p>
          <p><span class="pbmac-trust__check" aria-hidden="true">✓</span><span>{{ section.settings.trust_2 | escape }}</span></p>
        </div>

        <div class="pbmac-accordions">
          <details class="pbmac-accordion" {% if section.settings.open_description %}open{% endif %}>
            <summary>
              <span class="pbmac-accordion__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M5 3.5h11l3 3V20.5H5z" fill="currentColor"/>
                  <path d="M8 9h8M8 12h8M8 15h6" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </span>
              {{ section.settings.description_heading | escape }}
              <span class="pbmac-accordion__chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M7 9.5 12 14.5 17 9.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <div class="pbmac-accordion__content rte">
              {% if section.settings.description_body != blank %}
                {{ section.settings.description_body }}
              {% else %}
                {{ product.description }}
              {% endif %}
            </div>
          </details>

          <details class="pbmac-accordion">
            <summary>
              <span class="pbmac-accordion__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z" fill="currentColor"/>
                  <circle cx="7" cy="17" r="2" fill="currentColor"/>
                  <circle cx="18" cy="17" r="2" fill="currentColor"/>
                </svg>
              </span>
              {{ section.settings.shipping_heading | escape }}
              <span class="pbmac-accordion__chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M7 9.5 12 14.5 17 9.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <div class="pbmac-accordion__content rte">{{ section.settings.shipping_text }}</div>
          </details>

          <details class="pbmac-accordion">
            <summary>
              <span class="pbmac-accordion__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="9" fill="currentColor"/>
                  <circle cx="12" cy="7.5" r="1.3" fill="#fff"/>
                  <path d="M12 11v6" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
              {{ section.settings.personalization_info_heading | escape }}
              <span class="pbmac-accordion__chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M7 9.5 12 14.5 17 9.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <div class="pbmac-accordion__content rte">{{ section.settings.personalization_info }}</div>
          </details>
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.show_size_chart %}
    <div class="pbmac-modal" data-pbmac-sizechart hidden><div class="pbmac-modal__backdrop" data-pbmac-sizechart-close></div><div class="pbmac-modal__dialog pbmac-sizechart"><button type="button" class="pbmac-modal__close" data-pbmac-sizechart-close>×</button><h3>Size Chart</h3><p>There might be ±1.5 inches difference due to manual measurement and production processes.</p><div class="pbmac-sizechart__table-wrap"><h4>Classic Tee</h4><table><thead><tr><th>Size</th><th>Chest (Front Only)</th><th>Body Length</th></tr></thead><tbody><tr><td>S</td><td>18</td><td>28</td></tr><tr><td>M</td><td>20</td><td>29</td></tr><tr><td>L</td><td>22</td><td>30</td></tr><tr><td>XL</td><td>24</td><td>31</td></tr><tr><td>2XL</td><td>26</td><td>32</td></tr><tr><td>3XL</td><td>28</td><td>33</td></tr><tr><td>4XL</td><td>30</td><td>34</td></tr><tr><td>5XL</td><td>32</td><td>35</td></tr></tbody></table></div></div></div>
  {% endif %}
</section>

{% if section.settings.show_reviews %}
<section id="pbmac-reviews-{{ section.id }}" class="pbmac-reviews" data-pbmac-reviews>
  {% liquid
    assign pbmac_review_count = 0
    assign pbmac_rating_total = 0
    assign pbmac_count_5 = 0
    assign pbmac_count_4 = 0
    assign pbmac_count_3 = 0
    assign pbmac_count_2 = 0
    assign pbmac_count_1 = 0
    assign pbmac_image_review_count = 0

    for block in section.blocks
      if block.type == 'manual_review'
        assign pbmac_review_count = pbmac_review_count | plus: 1
        assign pbmac_rating_total = pbmac_rating_total | plus: block.settings.rating

        if block.settings.image != blank
          assign pbmac_image_review_count = pbmac_image_review_count | plus: 1
        endif

        case block.settings.rating
          when 5
            assign pbmac_count_5 = pbmac_count_5 | plus: 1
          when 4
            assign pbmac_count_4 = pbmac_count_4 | plus: 1
          when 3
            assign pbmac_count_3 = pbmac_count_3 | plus: 1
          when 2
            assign pbmac_count_2 = pbmac_count_2 | plus: 1
          when 1
            assign pbmac_count_1 = pbmac_count_1 | plus: 1
        endcase
      endif
    endfor

    if pbmac_review_count > 0
      assign pbmac_average = pbmac_rating_total | times: 1.0 | divided_by: pbmac_review_count
    else
      assign pbmac_average = 0
    endif
  %}

  <div class="page-width">
    <div class="pbmac-review-tabs-top">
      <span class="is-active">Product Reviews</span>
    </div>

    <div class="pbmac-reviews-layout">
      <aside class="pbmac-reviews-card">
        <h2>Reviews for this item</h2>

        {% if pbmac_review_count > 0 %}
          <div class="pbmac-reviews-card__score">
            <strong>{{ pbmac_average | round: 1 }}</strong>
            <div>
              <span class="pbmac-reviews-card__stars">★★★★★</span>
              <small>{{ pbmac_review_count }} Review{% if pbmac_review_count != 1 %}s{% endif %}</small>
            </div>
          </div>

          {% assign pbmac_counts = pbmac_count_5 | append: ',' | append: pbmac_count_4 | append: ',' | append: pbmac_count_3 | append: ',' | append: pbmac_count_2 | append: ',' | append: pbmac_count_1 | split: ',' %}
          <div class="pbmac-histogram">
            {% for star in (1..5) reversed %}
              {% assign idx = 5 | minus: star %}
              {% assign count = pbmac_counts[idx] | plus: 0 %}
              {% assign pct = count | times: 100 | divided_by: pbmac_review_count %}
              {% assign display_pct = pct %}
              {% if count > 0 and pct == 0 %}
                {% assign display_pct = 1 %}
              {% endif %}
              <div class="pbmac-histogram__row">
                <span>{{ star }} Star</span>
                <div><i style="width:{{ display_pct }}%"></i></div>
                <b>{% if count > 0 and pct == 0 %}&lt;1%{% else %}{{ pct }}%{% endif %}</b>
              </div>
            {% endfor %}
          </div>

          <span class="pbmac-review-static-button">Write a Review</span>
        {% else %}
          <p class="pbmac-empty-review">No product reviews yet.</p>
        {% endif %}
      </aside>

      <div class="pbmac-reviews-content">
        {% if pbmac_image_review_count > 0 %}
          <div class="pbmac-review-images-head">
            <h3>Reviews with Images</h3>
            <div class="pbmac-review-images-arrows">
              <button type="button" data-pbmac-images-prev aria-label="Previous images">‹</button>
              <button type="button" data-pbmac-images-next aria-label="Next images">›</button>
            </div>
          </div>

          <div class="pbmac-review-images" data-pbmac-review-images>
            {% assign pbmac_review_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'manual_review' %}
                {% if block.settings.image != blank %}
                  <button
                    type="button"
                    class="pbmac-review-image-card"
                    data-pbmac-image-review-index="{{ pbmac_review_index }}"
                    aria-label="Open review from {{ block.settings.author | escape }}"
                  >
                    {{
                      block.settings.image
                      | image_url: width: 500
                      | image_tag:
                        loading: 'lazy',
                        widths: '180,260,360,500',
                        class: 'pbmac-review-image-card__image',
                        alt: block.settings.title
                    }}
                  </button>
                {% endif %}
                {% assign pbmac_review_index = pbmac_review_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <div class="pbmac-topreviews-head">
          <h3>Top reviews</h3>
        </div>

        {% if pbmac_review_count > 0 %}
          <div class="pbmac-review-filters">
            <button class="is-active" type="button" data-rating="all">All Reviews ({{ pbmac_review_count }})</button>
            <button type="button" data-rating="5" {% if pbmac_count_5 == 0 %}disabled{% endif %}>5 Star ({{ pbmac_count_5 }})</button>
            <button type="button" data-rating="4" {% if pbmac_count_4 == 0 %}disabled{% endif %}>4 Star ({{ pbmac_count_4 }})</button>
            <button type="button" data-rating="3" {% if pbmac_count_3 == 0 %}disabled{% endif %}>3 Star ({{ pbmac_count_3 }})</button>
            <button type="button" data-rating="2" {% if pbmac_count_2 == 0 %}disabled{% endif %}>2 Star ({{ pbmac_count_2 }})</button>
            <button type="button" data-rating="1" {% if pbmac_count_1 == 0 %}disabled{% endif %}>1 Star ({{ pbmac_count_1 }})</button>
          </div>

          <div class="pbmac-review-list">
            {% assign pbmac_review_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'manual_review' %}
                <article
                  class="pbmac-review"
                  data-pbmac-review
                  data-rating="{{ block.settings.rating }}"
                  data-review-index="{{ pbmac_review_index }}"
                  role="button"
                  tabindex="0"
                  {{ block.shopify_attributes }}
                >
                  <div class="pbmac-review__headline">
                    <span class="pbmac-review__stars">
                      {% for i in (1..5) %}
                        <i class="{% if i <= block.settings.rating %}is-on{% endif %}">★</i>
                      {% endfor %}
                    </span>
                    <strong>{{ block.settings.author | escape }}</strong>
                  </div>

                  <div class="pbmac-review__meta">
                    {% if block.settings.verified %}<span>Verified Purchase</span>{% endif %}
                    {% if block.settings.date != blank %}<time>{{ block.settings.date | escape }}</time>{% endif %}
                  </div>

                  {% if block.settings.title != blank %}<h4>{{ block.settings.title | escape }}</h4>{% endif %}
                  {% if block.settings.body != blank %}<div class="pbmac-review__body rte">{{ block.settings.body }}</div>{% endif %}

                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 220
                      | image_tag:
                        loading: 'lazy',
                        widths: '90,140,220',
                        class: 'pbmac-review__thumb',
                        alt: block.settings.title
                    }}
                  {% endif %}

                  <template data-pbmac-review-modal-source>
                    <div class="pbmac-review-modal-source{% if block.settings.image == blank %} is-no-image{% endif %}">
                      {% if block.settings.image != blank %}
                        <div class="pbmac-review-modal-source__media">
                          {{
                            block.settings.image
                            | image_url: width: 1400
                            | image_tag:
                              loading: 'lazy',
                              widths: '600,900,1200,1400',
                              class: 'pbmac-review-modal-source__image',
                              alt: block.settings.title
                          }}
                        </div>
                      {% endif %}

                      <div class="pbmac-review-modal-source__details">
                        <div class="pbmac-review__headline">
                          <span class="pbmac-review__stars">
                            {% for i in (1..5) %}
                              <i class="{% if i <= block.settings.rating %}is-on{% endif %}">★</i>
                            {% endfor %}
                          </span>
                          <strong>{{ block.settings.author | escape }}</strong>
                        </div>

                        <div class="pbmac-review__meta">
                          {% if block.settings.verified %}<span>Verified Purchase</span>{% endif %}
                          {% if block.settings.date != blank %}<time>{{ block.settings.date | escape }}</time>{% endif %}
                        </div>

                        {% if block.settings.title != blank %}<h4>{{ block.settings.title | escape }}</h4>{% endif %}
                        {% if block.settings.body != blank %}<div class="rte">{{ block.settings.body }}</div>{% endif %}
                      </div>
                    </div>
                  </template>
                </article>

                {% assign pbmac_review_index = pbmac_review_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>

          <nav class="pbmac-pagination" aria-label="Review pages"></nav>
        {% elsif request.design_mode %}
          <div class="pbmac-empty-review">Add real customer reviews using “Manual review” blocks.</div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="pbmac-review-modal" hidden>
    <div class="pbmac-review-modal__backdrop" data-pbmac-review-close></div>
    <div class="pbmac-review-modal__dialog" role="dialog" aria-modal="true">
      <button type="button" class="pbmac-review-modal__close" data-pbmac-review-close>×</button>
      <button type="button" class="pbmac-review-modal__arrow pbmac-review-modal__arrow--prev" data-pbmac-review-prev>‹</button>
      <button type="button" class="pbmac-review-modal__arrow pbmac-review-modal__arrow--next" data-pbmac-review-next>›</button>
      <div class="pbmac-review-modal__content"></div>
    </div>
  </div>
</section>
{% endif %}



{% if section.settings.show_more_items %}
  {% liquid
    assign pbmac_more_source = blank

    if section.settings.more_items_collection != blank
      assign pbmac_more_source = section.settings.more_items_collection
    elsif product.collections.first != blank
      assign pbmac_more_source = product.collections.first
    endif
  %}

  {% if pbmac_more_source != blank %}
    <section class="pbmac-more-items" aria-labelledby="pbmac-more-items-title-{{ section.id }}">
      <div class="page-width">
        <div class="pbmac-more-items__inner">
          <h2 id="pbmac-more-items-title-{{ section.id }}">{{ section.settings.more_items_heading | escape }}</h2>

          <div class="pbmac-more-items__grid">
            {% assign pbmac_more_rendered = 0 %}
            {% for pbmac_more_product in pbmac_more_source.products %}
              {% if pbmac_more_product.id != product.id %}
                <a class="pbmac-more-card" href="{{ pbmac_more_product.url }}">
                  <div class="pbmac-more-card__media">
                    {% if pbmac_more_product.featured_image != blank %}
                      {{ pbmac_more_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'pbmac-more-card__image', alt: pbmac_more_product.title }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'pbmac-more-card__image pbmac-more-card__image--placeholder' }}
                    {% endif %}
                  </div>

                  <div class="pbmac-more-card__content">
                    <h3>{{ pbmac_more_product.title | escape }}</h3>

                    <div class="pbmac-more-card__stars" aria-hidden="true">★★★★★</div>

                    <div class="pbmac-more-card__price">
                      <span class="pbmac-more-card__sale">{{ pbmac_more_product.price | money }}</span>
                      {% if pbmac_more_product.compare_at_price > pbmac_more_product.price %}
                        <span class="pbmac-more-card__compare">{{ pbmac_more_product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                </a>

                {% assign pbmac_more_rendered = pbmac_more_rendered | plus: 1 %}
                {% if pbmac_more_rendered >= section.settings.more_items_limit %}
                  {% break %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
{% endif %}

{% if section.settings.show_newsletter %}
<section class="pbmac-newsletter" aria-labelledby="pbmac-newsletter-title-{{ section.id }}">
  <div class="page-width">
    <div class="pbmac-newsletter__inner">
      <div class="pbmac-newsletter__copy">
        <h2 id="pbmac-newsletter-title-{{ section.id }}">{{ section.settings.newsletter_heading | escape }}</h2>
        <p>{{ section.settings.newsletter_subtext | escape }}</p>
      </div>

      {% form 'customer', class: 'pbmac-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="pbmac-newsletter__field">
          <input
            type="email"
            name="contact[email]"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            placeholder="{{ section.settings.newsletter_placeholder | escape }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            aria-label="{{ section.settings.newsletter_placeholder | escape }}"
          >
          <button type="submit">{{ section.settings.newsletter_button | escape }}</button>
        </div>

        {% if form.posted_successfully? %}
          <p class="pbmac-newsletter__success">{{ section.settings.newsletter_success | escape }}</p>
        {% endif %}

        {% if form.errors %}
          <div class="pbmac-newsletter__error">{{ form.errors | default_errors }}</div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>
{% endif %}

