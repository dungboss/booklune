{% comment %}
  SECTION: Dải ảnh reaction
  Cách cài: Edit code → Sections → Add a new section → đặt tên
  "hw-photo-strip" → dán toàn bộ file này → Save.
  Mỗi ảnh 1 block, desktop xếp thành hàng ngang đều nhau,
  mobile tự chuyển thành dải trượt ngang (swipe).
{% endcomment %}

<div class="hwp-sec" style="background-color:{{ section.settings.section_bg }}">
<div class="hwp{% unless section.settings.full_width %} hwp--contain{% endunless %}{% if section.settings.hover_zoom %} hwp--zoom{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;--hwp-gap:{{ section.settings.gap }}px;--hwp-r:{{ section.settings.radius }}px;--hwp-ar:{{ section.settings.aspect }}">
  <div class="hwp__row" style="--hwp-cols:{{ section.blocks.size | at_most: 6 }}">
    {%- for block in section.blocks -%}
      <div class="hwp__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'hwp__img' }}
        {%- else -%}
          {%- assign hwp_n = forloop.index0 | modulo: 2 | plus: 1 -%}
          {%- assign hwp_ph = 'lifestyle-' | append: hwp_n -%}
          {{ hwp_ph | placeholder_svg_tag: 'hwp__img hwp__img--ph' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
</div>

<style>
  .hwp{margin:0 auto}
  .hwp--contain{max-width:1200px;padding-left:20px;padding-right:20px}
  .hwp *{box-sizing:border-box;margin:0;padding:0}
  .hwp__row{display:grid;grid-template-columns:repeat(var(--hwp-cols,4),minmax(0,1fr));gap:var(--hwp-gap,6px)}
  .hwp__item{border-radius:var(--hwp-r,8px);overflow:hidden;background:#1c1613}
  .hwp__img{width:100%;aspect-ratio:var(--hwp-ar,3/2);object-fit:cover;display:block;transition:transform .35s ease}
  .hwp--zoom .hwp__item:hover .hwp__img{transform:scale(1.05)}
  .hwp__img--ph{background:#241c17;fill:#5a4a3a}
  @media (max-width:749px){
    .hwp__row{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none}
    .hwp__row::-webkit-scrollbar{display:none}
    .hwp__item{flex:0 0 76%;scroll-snap-align:center}
  }
  @media (prefers-reduced-motion:reduce){.hwp__img{transition:none}.hwp--zoom .hwp__item:hover .hwp__img{transform:none}}
</style>

{% schema %}
{
  "name": "Dải ảnh reaction",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Tràn hết chiều ngang màn hình",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Phóng nhẹ ảnh khi di chuột",
      "default": true
    },
    {
      "type": "select",
      "id": "aspect",
      "label": "Tỉ lệ ảnh",
      "options": [
        { "value": "1/1", "label": "1:1 vuông" },
        { "value": "4/3", "label": "4:3" },
        { "value": "3/2", "label": "3:2" },
        { "value": "16/9", "label": "16:9" }
      ],
      "default": "3/2"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Khoảng cách giữa ảnh",
      "default": 6
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Bo góc ảnh",
      "default": 8
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Màu nền section",
      "default": "#0d0a09"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding trên",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding dưới",
      "default": 8
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "photo",
      "name": "Ảnh",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ảnh"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dải ảnh reaction",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
