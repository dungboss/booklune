{% style %}
.process-{{ section.id }}{padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};text-align:center}
.process-{{ section.id }} .wrap{max-width:var(--page-width);margin:auto}.process-{{ section.id }} h2{font-size:clamp(28px,4vw,44px);margin:0 0 10px}.process-{{ section.id }} .intro{max-width:680px;margin:0 auto 34px;color:rgba(var(--color-foreground),.7)}
.process-{{ section.id }} .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.process-{{ section.id }} .step{background:#fff;border-radius:16px;padding:26px 20px;border:1px solid rgba(0,0,0,.08)}.process-{{ section.id }} .num{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;margin:0 auto 16px;background:{{ section.settings.accent }};color:#fff;font-weight:800}.process-{{ section.id }} h3{margin:0 0 8px}.process-{{ section.id }} p{margin:0;color:rgba(var(--color-foreground),.7)}
@media(max-width:800px){.process-{{ section.id }} .steps{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.process-{{ section.id }} .steps{grid-template-columns:1fr}}
{% endstyle %}
<section class="process-{{ section.id }}"><div class="wrap"><h2>{{ section.settings.heading }}</h2><div class="intro">{{ section.settings.text }}</div><div class="steps">{% for block in section.blocks %}<div class="step" {{ block.shopify_attributes }}><div class="num">{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endfor %}</div></div></section>
{% schema %}
{"name":"How 3D orders work","settings":[{"type":"text","id":"heading","default":"Made Layer by Layer, Just for You","label":"Heading"},{"type":"textarea","id":"text","default":"A simple process from choosing your design to receiving a finished 3D-printed product.","label":"Text"},{"type":"color","id":"background","default":"#f6f4ef","label":"Background"},{"type":"color","id":"accent","default":"#111111","label":"Accent"},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"default":64,"label":"Top padding"},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"default":64,"label":"Bottom padding"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","default":"Choose Your Design","label":"Title"},{"type":"textarea","id":"text","default":"Pick a model, color and available personalization options.","label":"Text"}]}],"max_blocks":4,"presets":[{"name":"How 3D orders work","blocks":[{"type":"step"},{"type":"step","settings":{"title":"We Print It","text":"Your order is produced with controlled settings and durable materials."}},{"type":"step","settings":{"title":"Quality Checked","text":"Each piece is cleaned, inspected and prepared for shipment."}},{"type":"step","settings":{"title":"Delivered to You","text":"Track your package and enjoy your new 3D creation."}}]}]}
{% endschema %}
