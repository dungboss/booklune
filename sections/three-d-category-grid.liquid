{% style %}
  .td-grid-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};}
  .td-grid-{{ section.id }} .td-head{text-align:center;max-width:760px;margin:0 auto 28px;padding:0 20px}
  .td-grid-{{ section.id }} .td-head h2{margin:0 0 10px;font-size:clamp(28px,4vw,46px);line-height:1.1}
  .td-grid-{{ section.id }} .td-head p{margin:0;color:rgba(var(--color-foreground),.72)}
  .td-grid-{{ section.id }} .td-cards{display:grid;grid-template-columns:repeat({{ section.settings.columns }},minmax(0,1fr));gap:18px;padding:0 20px;max-width:var(--page-width);margin:auto}
  .td-grid-{{ section.id }} .td-card{position:relative;overflow:hidden;border-radius:18px;background:#eee;min-height:300px;display:flex;align-items:flex-end;text-decoration:none;color:#fff;isolation:isolate}
  .td-grid-{{ section.id }} .td-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(0,0,0,.78));z-index:-1}
  .td-grid-{{ section.id }} .td-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .45s ease}
  .td-grid-{{ section.id }} .td-card:hover img{transform:scale(1.04)}
  .td-grid-{{ section.id }} .td-placeholder{position:absolute;inset:0;background:linear-gradient(135deg,#ece7df,#c9c1b4);z-index:-2}
  .td-grid-{{ section.id }} .td-copy{padding:24px;width:100%}
  .td-grid-{{ section.id }} .td-copy h3{margin:0 0 5px;color:#fff;font-size:22px}
  .td-grid-{{ section.id }} .td-copy span{font-size:14px;font-weight:700;text-decoration:underline;text-underline-offset:4px}
  @media(max-width:990px){.td-grid-{{ section.id }} .td-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.td-grid-{{ section.id }} .td-cards{grid-template-columns:1fr;gap:14px}.td-grid-{{ section.id }} .td-card{min-height:260px}}
{% endstyle %}
<section class="td-grid-{{ section.id }}">
  <div class="td-head"><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
  <div class="td-cards">
    {% for block in section.blocks %}
      <a class="td-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw' }}
        {% else %}<div class="td-placeholder"></div>{% endif %}
        <div class="td-copy"><h3>{{ block.settings.title }}</h3><span>{{ block.settings.cta }}</span></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"3D category grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by Collection"},{"type":"textarea","id":"text","label":"Text","default":"Personalized key holders, bookish decor, can holders, zen gardens and seasonal gifts."},{"type":"range","id":"columns","min":2,"max":4,"step":1,"default":4,"label":"Desktop columns"},{"type":"color","id":"background","default":"#ffffff","label":"Background"},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"default":48,"label":"Top padding"},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"default":48,"label":"Bottom padding"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","default":"3D Collection","label":"Title"},{"type":"text","id":"cta","default":"Shop now","label":"Link text"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":8,"presets":[{"name":"3D category grid","blocks":[{"type":"category","settings":{"title":"Car Key Holders"}},{"type":"category","settings":{"title":"Book Counters & Trackers"}},{"type":"category","settings":{"title":"Can Holders & Coolers"}},{"type":"category","settings":{"title":"Halloween Decor"}}]}]}
{% endschema %}
