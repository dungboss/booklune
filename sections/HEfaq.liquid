<div class="hwq-sec" style="background-color:{{ section.settings.section_bg }}">
<div class="hwq" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;--hwq-maxw:{{ section.settings.card_max_width }}px;--hwq-card:{{ section.settings.card_bg }};--hwq-border:{{ section.settings.border_color }};--hwq-head:{{ section.settings.heading_color }};--hwq-q:{{ section.settings.q_color }};--hwq-a:{{ section.settings.a_color }};--hwq-accent:{{ section.settings.accent_color }};--hwq-h:{{ section.settings.heading_size }}px;--hwq-qs:{{ section.settings.q_size }}px;--hwq-as:{{ section.settings.a_size }}px">
  <div class="hwq__card">
    {%- if section.settings.heading != blank -%}
      <h2 class="hwq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <details class="hwq__item" {{ block.shopify_attributes }}>
        <summary class="hwq__q">{{ block.settings.question }}<span class="hwq__chev">&#9662;</span></summary>
        <div class="hwq__a">{{ block.settings.answer | newline_to_br }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>
</div>

<style>
  .hwq{max-width:1200px;margin:0 auto;padding-left:20px;padding-right:20px}
  .hwq *{box-sizing:border-box;margin:0;padding:0}
  .hwq__card{max-width:var(--hwq-maxw,900px);margin:0 auto;background:var(--hwq-card);border:1px solid var(--hwq-border);border-radius:18px;padding:22px 22px 10px}
  .hwq__heading{font-family:Georgia,'Times New Roman',serif;font-size:var(--hwq-h,24px);font-weight:700;color:var(--hwq-head);text-align:center;margin-bottom:12px}
  .hwq__item{border-bottom:1px solid var(--hwq-border)}
  .hwq__item:last-child{border-bottom:none}
  .hwq__q{display:flex;align-items:center;justify-content:space-between;gap:12px;list-style:none;cursor:pointer;padding:13px 4px;font-size:var(--hwq-qs,14px);font-weight:600;color:var(--hwq-q);overflow-wrap:break-word}
  .hwq__q::-webkit-details-marker{display:none}
  .hwq__chev{color:var(--hwq-accent);font-size:13px;transition:transform .25s ease;flex:0 0 auto}
  .hwq__item[open] .hwq__chev{transform:rotate(180deg)}
  .hwq__a{padding:0 4px 14px;font-size:var(--hwq-as,13px);line-height:1.6;color:var(--hwq-a);overflow-wrap:break-word}
  @media (prefers-reduced-motion:reduce){.hwq__chev{transition:none}}
</style>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề",
      "default": "FAQ"
    },
    {
      "type": "range",
      "id": "card_max_width",
      "min": 500,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Độ rộng tối đa của card",
      "default": 900
    },
    {
      "type": "header",
      "content": "Màu sắc"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Màu nền section",
      "default": "#0d0a09"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Màu nền card",
      "default": "#14100d"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Màu viền & đường kẻ",
      "default": "#3d2b1c"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Màu tiêu đề",
      "default": "#f3e9d2"
    },
    {
      "type": "color",
      "id": "q_color",
      "label": "Màu câu hỏi",
      "default": "#efe4cd"
    },
    {
      "type": "color",
      "id": "a_color",
      "label": "Màu câu trả lời",
      "default": "#c2b5a6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Màu mũi tên",
      "default": "#d8a35a"
    },
    {
      "type": "header",
      "content": "Cỡ chữ & khoảng cách"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Cỡ chữ tiêu đề",
      "default": 24
    },
    {
      "type": "range",
      "id": "q_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Cỡ chữ câu hỏi",
      "default": 14
    },
    {
      "type": "range",
      "id": "a_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Cỡ chữ câu trả lời",
      "default": 13
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding trên",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding dưới",
      "default": 40
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "qa",
      "name": "Câu hỏi",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Câu hỏi",
          "default": "Question?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Câu trả lời",
          "default": "Answer goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "qa", "settings": { "question": "How do I set it up?", "answer": "Follow the 4-step setup guide above — it takes about 5 minutes with no tools required." } },
        { "type": "qa", "settings": { "question": "What do I need to operate it?", "answer": "Just add water and plug it in. Everything else is included in the box." } },
        { "type": "qa", "settings": { "question": "Is the mist maker safe to use?", "answer": "Yes — it uses ultrasonic cool mist technology, no heat and no chemicals." } },
        { "type": "qa", "settings": { "question": "Can I use different colored water?", "answer": "We recommend plain water. The green glow comes from the built-in LED, so no dye is needed." } },
        { "type": "qa", "settings": { "question": "How do I clean it?", "answer": "Empty the water after each use and wipe the cauldron with a soft dry cloth." } }
      ]
    }
  ]
}
{% endschema %}
