<style>
  .recommended-apps-wrapper summary {
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    padding: 1rem 0;
  }

  .recommended-apps-wrapper details[open] summary::after {
    content: "▲";
    float: right;
  }

  .recommended-apps-wrapper summary::after {
    content: "▼";
    float: right;
  }

  .recommended-apps-wrapper p {
    font-size: 14px;
    margin-bottom: 1rem;
    color: #444;
  }

  .recommended-apps-wrapper ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 2rem;
  }

  .recommended-apps-wrapper li {
    margin-bottom: 0.5rem;
  }

  .recommended-apps-wrapper a {
    color: #0077cc;
    text-decoration: underline;
  }
</style>

<div class="recommended-apps-wrapper page-width">
  <details>
    <summary>💰 Add These Apps</summary>
    <div>
      <p>
        Add these must-have apps to unlock more revenue from your store. Once you've installed them all, feel free to remove this section.
      </p>

      <p style="color: red; font-weight: bold; margin-bottom: 10px;">
        IMPORTANT: Right-click and open link in a new tab, then install.
      </p>

      <ul>
        <li>
          <a href="https://loox.io/app/RICKY" target="_blank" rel="noopener noreferrer">
            Loox Reviews
          </a> – Add photo and video reviews to boost sales and conversion rate
        </li>

        <li>
          <a href="https://apps.shopify.com/cart-upsell?mref=wmkufzuw" target="_blank" rel="noopener noreferrer">
            KachingCart
          </a> – Customize your cart & add upsells/urgency
        </li>

        <li>
          <a href="https://try.aftersell.app/lbbysve3v99s" target="_blank" rel="noopener noreferrer">
            AfterSell
          </a> – Maximize revenue with post-purchase upsells
        </li>

        <li>
          <a href="https://apps.shopify.com/checkboost-checkbox-upsells" target="_blank" rel="noopener noreferrer">
            CheckBoost
          </a> – Boost AOV with checkbox upsells
        </li>

        <li>
          <a href="https://parcelpanel.com?ref=60vkQC9O" target="_blank" rel="noopener noreferrer">
            ParcelPanel
          </a> – Branded order tracking page with upsells
        </li>

        <li>
          <a href="https://txtcartapp.com/affiliate/?mref=wmkufzuw" target="_blank" rel="noopener noreferrer">
            TxtCart
          </a> – Recover abandoned carts and boost sales with texting
        </li>

        <li>
          <a href="https://your.omnisend.com/PydmYR" target="_blank" rel="noopener noreferrer">
            Omnisend
          </a> – Email marketing made easy (recover abandoned carts, boost sales, popups, automation)
        </li>
      </ul>
    </div>
  </details>
</div>

{% schema %}
{
  "name": "💰 Add These Apps",
  "settings": [],
  "presets": [
    {
      "name": "💰 Add These Apps"
    }
  ]
}
{% endschema %}
