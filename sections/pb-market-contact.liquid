<section class="pm-section pm-contact-section"><div class="pm-shell pm-contact"><div><span class="pm-kicker">WE'RE HERE TO HELP</span><h1>Contact Crestoria</h1><p>Have a question about a product, personalization or an order? Send us a message below.</p>{% if settings.crestoria_support_email != blank %}{% render 'crestoria-support-link' %}{% endif %}<p class="pm-muted">For order questions, include your order number and the email address used at checkout.</p></div><div>{% form 'contact', id: 'PMContact', class: 'pm-contact-form' %}{% if form.posted_successfully? %}<p class="pm-contact-success" role="status">Thanks for reaching out. Your message has been sent to Crestoria.</p>{% endif %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}<div class="pm-contact-fields"><div><label for="PMContactName">Name</label><input id="PMContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required></div><div><label for="PMContactEmail">Email address</label><input id="PMContactEmail" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required></div></div><label for="PMContactOrder">Order number (optional)</label><input id="PMContactOrder" type="text" name="contact[Order number]" autocomplete="off"><label for="PMContactMessage">Your message</label><textarea id="PMContactMessage" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea><button class="pm-button" type="submit">Send message {% render 'pb-market-icon', icon: 'arrow' %}</button>{% endform %}</div></div></section>
{% schema %}
{"name":"Crestoria Contact","tag":"section","class":"pm-section-host","settings":[],"presets":[{"name":"Crestoria Contact"}]}
{% endschema %}
